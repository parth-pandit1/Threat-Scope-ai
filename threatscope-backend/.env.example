# ============================================
# ThreatScope AI — Environment Configuration Example
# ============================================

# ── Database ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://threatscope:password@db:5432/threatscope

# ── Redis ────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO Object Storage ─────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=threatscope-files
MINIO_SECURE=False
MINIO_PUBLIC_URL=http://localhost:9000

# ── External APIs ────────────────────────
VIRUSTOTAL_API_KEY=your-vt-key-here
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=

# ── Yara Repos ───────────────────────────
YARA_REPO_1_URL=https://github.com/Yara-Rules/rules.git
YARA_REPO_2_URL=https://github.com/Neo23x0/signature-base.git
YARA_BASE_DIR=/app/yara_rules/repos
COMPILED_RULES_PATH=/app/yara_rules/compiled.yarc

# ── App Settings ─────────────────────────
MAX_FILE_SIZE_MB=50
RATE_LIMIT_PER_HOUR=10
CORS_ORIGINS=["http://localhost:3000"]

# ── JWT Auth Settings ────────────────────
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ollama (Local LLM) ──────────────────
OLLAMA_URL=http://ollama:11434/api/generate
OLLAMA_MODEL=mistral

# ── Sentry Error Tracking ───────────────
SENTRY_DSN=
